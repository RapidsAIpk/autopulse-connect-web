# Where the NestJS API (autopulse-connect-api) runs. Next forwards /api and the backend's own pages there,
# so the browser stays on one origin (cookies, CSV downloads, /media images all work as before).
API_ORIGIN=http://localhost:4009
# Socket.io connects straight to the API (Next's forwarding does not carry websockets).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4009
